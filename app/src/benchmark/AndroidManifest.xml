<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <permission android:name="${applicationId}.permission.SEED_FIXTURE" android:protectionLevel="signature" />
    <queries><package android:name="io.github.nakanomk.stacklife.macrobenchmark" /></queries>
    <application android:name=".benchmark.BenchmarkApplication" tools:replace="android:name">
        <profileable android:shell="true" />
        <provider android:name=".benchmark.FixtureProvider" android:authorities="${applicationId}.fixture"
            android:exported="true" android:readPermission="android.permission.DUMP"
            android:writePermission="${applicationId}.permission.SEED_FIXTURE" />
    </application>
</manifest>
