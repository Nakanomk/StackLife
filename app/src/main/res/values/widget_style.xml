<resources>
    <color name="widget_surface">#F5F7FF</color>
    <color name="widget_ink">#151B28</color>
    <color name="widget_accent">#304C81</color>
    <style name="WidgetText">
        <item name="android:textColor">@color/widget_ink</item>
        <item name="android:textSize">15sp</item>
        <item name="android:gravity">center_vertical|start</item>
        <item name="android:ellipsize">end</item>
        <item name="android:includeFontPadding">false</item>
    </style>
    <style name="WidgetControl" parent="WidgetText">
        <item name="android:textColor">@color/widget_accent</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:maxLines">1</item>
    </style>
</resources>
